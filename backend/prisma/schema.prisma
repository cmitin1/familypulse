generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HomeRole {
  OWNER
  MEMBER
}

enum InviteStatus {
  ACTIVE
  REVOKED
}

enum TaskStatus {
  OPEN
  DONE
}

enum RoutineScheduleType {
  DAILY
  WEEKLY
}

enum AssigneeMode {
  FIXED
  ROTATE
}

enum SourceType {
  TASK
  ROUTINE
  CHECKIN
}

model User {
  id             String       @id @default(cuid())
  telegramId     String       @unique
  username       String?
  firstName      String?
  lastName       String?
  activeHomeId   String?
  activeHome     Home?        @relation("ActiveHome", fields: [activeHomeId], references: [id])
  memberships    HomeMember[]
  tasksAssigned  Task[]       @relation("TaskAssignee")
  routinesFixed  Routine[]    @relation("RoutineFixedAssignee")
  routineDone    RoutineInstance[] @relation("RoutineDoneBy")
  scoreEvents    ScoreEvent[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  assignedRoutineInstances RoutineInstance[] @relation("RoutineInstanceAssignee")
}

model Home {
  id             String       @id @default(cuid())
  name           String
  timezone       String       @default("UTC")
  members        HomeMember[]
  invites        Invite[]
  tasks          Task[]
  routines       Routine[]
  routineInstances RoutineInstance[]
  scoreEvents    ScoreEvent[]
  streaks        Streak[]
  chatLinks      ChatLink[]
  activeUsers    User[]       @relation("ActiveHome")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model HomeMember {
  id         String   @id @default(cuid())
  homeId     String
  userId     String
  role       HomeRole @default(MEMBER)
  home       Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([homeId, userId])
}

model Invite {
  id         String       @id @default(cuid())
  code       String       @unique
  homeId     String
  createdById String
  maxUses    Int?
  usesCount  Int          @default(0)
  expiresAt  DateTime?
  status     InviteStatus @default(ACTIVE)
  home       Home         @relation(fields: [homeId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())
}

model Task {
  id          String     @id @default(cuid())
  homeId      String
  title       String
  description String?
  dueDate     DateTime?
  assigneeId  String?
  points      Int        @default(5)
  status      TaskStatus @default(OPEN)
  doneAt      DateTime?
  doneById    String?
  home        Home       @relation(fields: [homeId], references: [id], onDelete: Cascade)
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Routine {
  id              String              @id @default(cuid())
  homeId           String
  title            String
  scheduleType     RoutineScheduleType
  daysOfWeek       Int[]
  timeOfDay        String?
  assigneeMode     AssigneeMode
  fixedAssigneeId  String?
  points           Int                 @default(3)
  isActive         Boolean             @default(true)
  home             Home                @relation(fields: [homeId], references: [id], onDelete: Cascade)
  fixedAssignee    User?               @relation("RoutineFixedAssignee", fields: [fixedAssigneeId], references: [id], onDelete: SetNull)
  instances        RoutineInstance[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model RoutineInstance {
  id          String    @id @default(cuid())
  homeId      String
  routineId   String
  date        DateTime
  assigneeId  String?
  isDone      Boolean   @default(false)
  doneAt      DateTime?
  doneById    String?
  home        Home      @relation(fields: [homeId], references: [id], onDelete: Cascade)
  routine     Routine   @relation(fields: [routineId], references: [id], onDelete: Cascade)
  assignee    User?     @relation("RoutineInstanceAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  doneBy      User?     @relation("RoutineDoneBy", fields: [doneById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([routineId, date])
}

model ScoreEvent {
  id          String    @id @default(cuid())
  homeId      String
  userId      String
  sourceType  SourceType
  sourceId    String
  points      Int
  createdAt   DateTime  @default(now())
  home        Home      @relation(fields: [homeId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([homeId, userId, sourceType, sourceId])
}

model Streak {
  id          String    @id @default(cuid())
  homeId      String
  date        DateTime
  closedById  String?
  createdAt   DateTime  @default(now())
  home        Home      @relation(fields: [homeId], references: [id], onDelete: Cascade)

  @@unique([homeId, date])
}

model ChatLink {
  id               String   @id @default(cuid())
  homeId           String
  telegramChatId   String
  enabled          Boolean  @default(true)
  lastDigestYmd    String?
  lastCheckinYmd   String?
  home             Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([homeId, telegramChatId])
}
