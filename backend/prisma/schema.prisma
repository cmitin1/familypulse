generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum HomeRole {
  OWNER
  MEMBER
}

enum InviteStatus {
  ACTIVE
  REVOKED
}

enum TaskStatus {
  OPEN
  DONE
}

enum RoutineScheduleType {
  DAILY
  WEEKLY
}

enum AssigneeMode {
  FIXED
  ROTATE
}

enum SourceType {
  TASK
  ROUTINE
  CHECKIN
}

enum EventSource {
  MANUAL
  ICS
}

enum AiExtractionRunStatus {
  PENDING
  SUCCESS
  ERROR
}

enum AiSuggestionType {
  TASK
  EVENT
  QUESTION
}

enum AiSuggestionStatus {
  PENDING
  APPROVED
  REJECTED
  IGNORED
}

enum AiAssigneeMode {
  SINGLE
  ALL
  UNASSIGNED
}

model User {
  id             String       @id @default(cuid())
  telegramId     String       @unique
  username       String?
  firstName      String?
  lastName       String?
  activeHomeId   String?
  activeHome     Home?        @relation("ActiveHome", fields: [activeHomeId], references: [id])
  memberships    HomeMember[]
  tasksAssigned  Task[]       @relation("TaskAssignee")
  taskAssignees  TaskAssignee[]
  routinesFixed  Routine[]    @relation("RoutineFixedAssignee")
  routineDone    RoutineInstance[] @relation("RoutineDoneBy")
  scoreEvents    ScoreEvent[]
  ownedEvents    Event[]      @relation("EventOwner")
  eventParticipants EventParticipant[]
  aiApprovedSuggestions AiSuggestion[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  assignedRoutineInstances RoutineInstance[] @relation("RoutineInstanceAssignee")
}

model Home {
  id             String       @id @default(cuid())
  name           String
  timezone       String       @default("UTC")
  members        HomeMember[]
  invites        Invite[]
  tasks          Task[]
  routines       Routine[]
  routineInstances RoutineInstance[]
  scoreEvents    ScoreEvent[]
  streaks        Streak[]
  chatLinks      ChatLink[]
  calendarFeeds  CalendarFeed[]
  calendarEvents CalendarEvent[]
  events         Event[]
  aiChatConnections AiChatConnection[]
  aiExtractionRuns AiExtractionRun[]
  aiSuggestions  AiSuggestion[]
  activeUsers    User[]       @relation("ActiveHome")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model HomeMember {
  id         String   @id @default(cuid())
  homeId     String
  userId     String
  role       HomeRole @default(MEMBER)
  home       Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([homeId, userId])
}

model Invite {
  id         String       @id @default(cuid())
  code       String       @unique
  homeId     String
  createdById String
  maxUses    Int?
  usesCount  Int          @default(0)
  expiresAt  DateTime?
  status     InviteStatus @default(ACTIVE)
  home       Home         @relation(fields: [homeId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())
}

model Task {
  id          String     @id @default(cuid())
  homeId      String
  title       String
  description String?
  dueDate     DateTime?
  assigneeId  String?
  eventId     String?
  points      Int        @default(5)
  status      TaskStatus @default(OPEN)
  doneAt      DateTime?
  doneById    String?
  home        Home       @relation(fields: [homeId], references: [id], onDelete: Cascade)
  assignee    User?      @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  assignees   TaskAssignee[]
  event       Event?     @relation(fields: [eventId], references: [id], onDelete: SetNull)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model TaskAssignee {
  id      String @id @default(cuid())
  taskId  String
  userId  String
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
}

model Event {
  id           String    @id @default(cuid())
  homeId       String
  title        String
  description  String?
  startAt      DateTime
  endAt        DateTime
  allDay       Boolean   @default(false)
  ownerId      String
  colorTag     String?
  source       EventSource @default(MANUAL)
  home         Home      @relation(fields: [homeId], references: [id], onDelete: Cascade)
  owner        User      @relation("EventOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  participants EventParticipant[]
  tasks        Task[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([homeId, startAt])
}

model EventParticipant {
  id      String @id @default(cuid())
  eventId String
  userId  String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
}

model Routine {
  id              String              @id @default(cuid())
  homeId           String
  title            String
  scheduleType     RoutineScheduleType
  daysOfWeek       Int[]
  timeOfDay        String?
  assigneeMode     AssigneeMode
  fixedAssigneeId  String?
  points           Int                 @default(3)
  isActive         Boolean             @default(true)
  home             Home                @relation(fields: [homeId], references: [id], onDelete: Cascade)
  fixedAssignee    User?               @relation("RoutineFixedAssignee", fields: [fixedAssigneeId], references: [id], onDelete: SetNull)
  instances        RoutineInstance[]
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
}

model RoutineInstance {
  id          String    @id @default(cuid())
  homeId      String
  routineId   String
  date        DateTime
  assigneeId  String?
  isDone      Boolean   @default(false)
  doneAt      DateTime?
  doneById    String?
  home        Home      @relation(fields: [homeId], references: [id], onDelete: Cascade)
  routine     Routine   @relation(fields: [routineId], references: [id], onDelete: Cascade)
  assignee    User?     @relation("RoutineInstanceAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  doneBy      User?     @relation("RoutineDoneBy", fields: [doneById], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([routineId, date])
}

model ScoreEvent {
  id          String    @id @default(cuid())
  homeId      String
  userId      String
  sourceType  SourceType
  sourceId    String
  points      Int
  createdAt   DateTime  @default(now())
  home        Home      @relation(fields: [homeId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([homeId, userId, sourceType, sourceId])
}

model Streak {
  id          String    @id @default(cuid())
  homeId      String
  date        DateTime
  closedById  String?
  createdAt   DateTime  @default(now())
  home        Home      @relation(fields: [homeId], references: [id], onDelete: Cascade)

  @@unique([homeId, date])
}

model ChatLink {
  id               String   @id @default(cuid())
  homeId           String
  telegramChatId   String
  enabled          Boolean  @default(true)
  lastDigestYmd    String?
  lastCheckinYmd   String?
  lastDeadlineMorningYmd String?
  lastDeadlineEveningYmd String?
  home             Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([homeId, telegramChatId])
}

model CalendarFeed {
  id           String   @id @default(cuid())
  homeId       String
  title        String
  icsUrl       String
  isEnabled    Boolean  @default(true)
  lastSyncedAt DateTime?
  home         Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  events       CalendarEvent[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([homeId, icsUrl])
}

model CalendarEvent {
  id          String   @id @default(cuid())
  homeId      String
  feedId      String
  uid         String
  title       String
  description String?
  location    String?
  startAt     DateTime
  endAt       DateTime
  allDay      Boolean  @default(false)
  hash        String
  home        Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  feed        CalendarFeed @relation(fields: [feedId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([feedId, uid, startAt])
  @@index([homeId, startAt])
  @@index([feedId, startAt])
}

model TelegramMessage {
  id                        String   @id @default(cuid())
  telegramChatId            String
  telegramMessageId         Int
  telegramUserId            String?
  senderName                String?
  username                  String?
  text                      String?
  rawType                   String
  sentAt                    DateTime
  replyToTelegramMessageId  Int?
  rawJson                   Json?
  createdAt                 DateTime @default(now())

  @@unique([telegramChatId, telegramMessageId])
  @@index([telegramChatId, sentAt])
  @@index([telegramChatId, telegramMessageId])
}

model AiChatConnection {
  id                    String   @id @default(cuid())
  homeId                String
  telegramChatId        String
  chatTitle             String?
  isEnabled             Boolean  @default(false)
  analysisIntervalMinutes Int    @default(60)
  lastAnalyzedAt        DateTime?
  lastAnalyzedMessageId Int?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  home                  Home     @relation(fields: [homeId], references: [id], onDelete: Cascade)
  extractionRuns        AiExtractionRun[]

  @@unique([homeId, telegramChatId])
  @@index([isEnabled, updatedAt])
}

model AiExtractionRun {
  id                  String              @id @default(cuid())
  homeId              String
  aiChatConnectionId  String
  status              AiExtractionRunStatus @default(PENDING)
  model               String
  provider            String
  promptVersion       String
  periodStart         DateTime
  periodEnd           DateTime
  messagesCount       Int
  inputTokens         Int?
  outputTokens        Int?
  costUsd             Decimal?            @db.Decimal(10, 6)
  rawResponse         Json?
  errorMessage        String?
  createdAt           DateTime            @default(now())
  finishedAt          DateTime?
  home                Home                @relation(fields: [homeId], references: [id], onDelete: Cascade)
  chatConnection      AiChatConnection    @relation(fields: [aiChatConnectionId], references: [id], onDelete: Cascade)
  suggestions         AiSuggestion[]

  @@index([homeId, createdAt])
  @@index([aiChatConnectionId, createdAt])
}

model AiSuggestion {
  id                      String            @id @default(cuid())
  homeId                  String
  sourceChatId            String
  type                    AiSuggestionType
  title                   String
  description             String?
  status                  AiSuggestionStatus @default(PENDING)
  confidence              Float?
  proposedAssigneeMode    AiAssigneeMode?
  proposedAssigneeUserIds Json?
  proposedDueAt           DateTime?
  proposedStartAt         DateTime?
  proposedEndAt           DateTime?
  sourceMessageRefs       Json
  dedupKey                String?
  aiExtractionRunId       String?
  approvedByUserId        String?
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  home                    Home              @relation(fields: [homeId], references: [id], onDelete: Cascade)
  extractionRun           AiExtractionRun?  @relation(fields: [aiExtractionRunId], references: [id], onDelete: SetNull)
  approvedBy              User?             @relation(fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([homeId, status, createdAt(sort: Desc)])
  @@index([homeId, type, status])
  @@index([dedupKey])
}
